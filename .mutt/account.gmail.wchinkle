set from="wchinkle@gmail.com"
set realname="Wesley Hinkle"

set smtp_url="smtp://wchinkle@smtp.gmail.com:587/"
set smtp_pass="`pass wchinkle@gmail.com/mutt`"

set imap_user="wchinkle@gmail.com"
set imap_pass="`pass wchinkle@gmail.com/mutt`"

set folder="imaps://imap.gmail.com:993"
set spoolfile="+INBOX"

set record="=[Gmail]/Sent Mail"
set postponed="=[Gmail]/Drafts"
set trash="=[Gmail]/Trash"

save-hook . "=[Gmail]/All Mail"
send-hook . set signature=~/.mutt/sig
