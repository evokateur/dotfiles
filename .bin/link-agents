#!/bin/bash

set -euo pipefail

project="${1:-$(basename "$(pwd -P)")}"

agents_file_relative_path="../../vaults/caveau/projects/${project}/llm-context/agents.md"

if [ ! -f "$agents_file_relative_path" ]; then
    printf '%s\n' "$agents_file_relative_path: No such file, exiting." >&2
    exit 1
fi

confirm() {
    if [ -z "$1" ]; then
        printf "confirm: missing prompt\n" >&2
        exit 2
    fi

    prompt=$1

    # require a TTY to prompt
    [ -t 0 ] || return 1

    printf "%s " "$prompt" >&2
    IFS= read -r answer

    case "$answer" in
    [yY] | [yY]*)
        unset answer prompt
        return 0
        ;;
    *)
        unset answer prompt
        return 1
        ;;
    esac
}

create_link() {
    local linkname="$1"

    if [ -f "$linkname" ] && [ ! -L "$linkname" ]; then
        printf 'A real %s is here; leaving it alone.\n' "$linkname"
        ls -l "$linkname"
        return
    fi

    if [ -L "$linkname" ]; then
        ls -l "$linkname"
        confirm "Replace $linkname?" && rm -f -- "$linkname"
    fi

    if [ ! -L "$linkname" ]; then
        printf 'Creating %s symlink..\n' "$linkname"
        ln -s "$agents_file_relative_path" "$linkname"
        ls -l "$linkname"
    fi
}

create_link AGENTS.md
create_link CLAUDE.md
