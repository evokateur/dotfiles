#!/bin/bash

. "$HOME/.bin/helpers/fancy-echo.sh"
. "$HOME/.config/shell/functions/dotfiles.sh"

blue_italic_echo "Running 'dotfiles pull'.."
dotfiles pull

blue_italic_echo "\nRunning 'pass git pull'.."
pass git pull

blue_italic_echo "\nRunning 'git pull' in ~/.config/nvim.."
cd ~/.config/nvim && git pull

blue_italic_echo "\nRunning 'git pull' in ${VAULT_ROOT}.."
cd "$VAULT_ROOT" && git pull

blue_italic_echo "\nRunning 'git pull' in ~/code/cv-joint.."
cd ~/code/cv-joint && git pull
