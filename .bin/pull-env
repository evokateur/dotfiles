#!/bin/bash

. "$HOME/.bin/helpers/fancy-echo.sh"
. "$HOME/.config/shell/functions/dotfiles.sh"

blue_italic_echo "Running 'dotfiles pull'..\n"
dotfiles pull

blue_italic_echo "Running 'pass git pull'..\n"
pass git pull

blue_italic_echo "Running 'git pull' in ~/.config/nvim..\n"
cd ~/.config/nvim && git pull

blue_italic_echo "Running 'git pull' in ${VAULT_PATH}..\n"
cd "$VAULT_PATH" && git pull

blue_italic_echo "Running 'git pull' in ~/code/cv-joint.."
cd ~/code/cv-joint && git pull
