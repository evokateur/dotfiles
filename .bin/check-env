#!/bin/bash

. "$HOME/.bin/helpers/fancy-echo.sh"
. "$HOME/.config/shell/functions/dotfiles.sh"

blue_italic_echo "Running 'dotfiles status'.."
dotfiles status

blue_italic_echo "\nRunning 'pass git status'.."
pass git status

blue_italic_echo "\nRunning 'git status' in ~/.config/nvim.."
cd ~/.config/nvim && git status

blue_italic_echo "\nRunning 'git status' in ${VAULT_ROOT}.."
cd "$VAULT_ROOT" && git status
