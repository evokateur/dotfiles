#!/bin/bash
set -euo pipefail

config_dir="${HOME}/.config/dconf"

if [[ ! -d "$config_dir" ]]; then
    exit 0
fi

host="${HOSTNAME:-$(hostname 2>/dev/null || true)}"
host="${host%%.*}"

if [[ -z "$host" ]]; then
    echo "Could not determine hostname, exiting."
    exit 1
fi

dump_file="${config_dir}/${host}.conf"

[[ -f "$dump_file" && -r "$dump_file" && -s "$dump_file" ]] || {
    echo "Not found or empty: $dump_file"
    exit 1
}

is_valid_dconf_dump() {
    local file="$1"
    grep -qE '^\[[a-zA-Z0-9_/-]+\]' "$file" || return 1
    grep -qE '^[a-zA-Z0-9_-]+=' "$file" || return 1
}

if is_valid_dconf_dump "$dump_file"; then
    echo "Loading user dconf from $dump_file.."
    dconf load / <"$dump_file"
else
    echo "$dump_file does not seem to be a dconf dump."
fi
